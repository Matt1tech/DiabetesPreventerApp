# Copy these names into ../.private/.env. Never commit the real values.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_SECURE_SSL_REDIRECT=False

# Use sqlite locally, or select postgresql and provide all database values.
DATABASE_ENGINE=sqlite
SQLITE_PATH=../.private/database/db.sqlite3
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_SSL_MODE=prefer

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

FOODVISOR_API_KEY=
FOODVISOR_API_URL=https://vision.foodvisor.io/api/1.0/en/analysis/
DIABETES_MODEL_PATH=../.private/models/diabetes_prediction_model.pkl
MAX_IMAGE_UPLOAD_BYTES=5242880
LOG_LEVEL=INFO
